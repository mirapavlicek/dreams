<?xml version="1.0"?>
<!--
    Datové pole s toutéž palubovkou jako aplikace v ../RideDashboard, jen
    zabydlené v nativní datové obrazovce přístroje. Seznam <iq:product> se dá
    přegenerovat skriptem garmin/tools/sync_devices.py.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="RideFieldApp" id="8b41d6c2e7a94f13bd05c8e2a17f4620" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0" name="@Strings.AppName" type="datafield">
        <iq:products>
            <iq:product id="edge1030"/>
            <iq:product id="edge1030bontrager"/>
            <iq:product id="edge1030plus"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edge530"/>
            <iq:product id="edge540"/>
            <iq:product id="edge550"/>
            <iq:product id="edge830"/>
            <iq:product id="edge840"/>
            <iq:product id="edge850"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>
        <iq:permissions>
            <!-- Kanál kola drží ../RideTrip, kde se dojezd kreslí; oprávnění
                 tu zůstávají jen proto, že se sdílený kód s obsluhou senzorů
                 bez nich nepřeloží. -->
            <iq:uses-permission id="Ant"/>
